# development | production
APP_ENV=development
# Local default is SQLite. PostgreSQL later: postgresql+psycopg://user:pass@host/dbname (needs a driver and migrations, see README)
DATABASE_URL=sqlite:///./skillforge.db
# REQUIRED in production. In development a random secret is generated into .dev_jwt_secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ADMIN_EMAIL=skillforgelearning22@gmail.com
SESSION_HOURS=8
CORS_ORIGINS=http://localhost:5173
# Heartbeat window used to decide whether a student is online
ONLINE_TIMEOUT_SECONDS=150

# --- Optional external services (features report "not configured" until set) ---
# Judge0 server for running code (Python, Java, C, C++). Example: http://localhost:2358
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=

# --- Razorpay (certificate payments). Get the keys from the Razorpay dashboard (Test Mode first).
# The KEY_ID is public. The KEY_SECRET must NEVER be shared, committed, or put in frontend code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: only for the webhook (Razorpay dashboard > Webhooks). A separate secret you choose.
RAZORPAY_WEBHOOK_SECRET=
# First-run default certificate price in rupees (same for every course). After that the admin changes it in Admin > Settings.
CERTIFICATE_PRICE_INR=55

# --- Email (admin payment alerts and sending certificates). Gmail needs an App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Final exam unlock rule: "attempted" (every topic test attended) or "passed" (every topic test passed)
FINAL_UNLOCK_RULE=attempted

# --- v7 payments
# Name shown in the Razorpay checkout window.
BRAND_NAME=SkillForge AI
# Direct UPI (your own UPI id, confirmed by you in Admin > Payments) and the Razorpay method list are set by the admin in
# Admin > Settings > Payment methods, not here. Use rzp_test_ keys first, rzp_live_ only after testing and KYC.

# Copy this file to .env.app and set the address of your SkillForge backend as the PHONE sees it.
# Same Wi-Fi test:  http://192.168.1.50:8000   (your PC's IPv4 address from `ipconfig`, backend started with --host 0.0.0.0)
# Real deployment:  https://api.yourdomain.com
VITE_API_BASE=http://192.168.1.50:8000
